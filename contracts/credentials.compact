pragma language_version >= 0.23;

import CompactStandardLibrary;

// ─── Level 3: Confidential Compliance Credentials ────────────────────────────
//
// An issuer registers credentials for holders; a holder later proves, from
// their own wallet, that they hold a credential that is valid — not revoked
// and not expired at the current block time — without revealing the
// credential's content (e.g. the audit score) or who the holder is.
//
// Public ledger state (visible to everyone):
//   - the issuer's public key
//   - per credential ID: an opaque commitment, the credential TYPE, the
//     EXPIRY (seconds since epoch), whether it is revoked, and whether a
//     valid proof has been presented
//
// Never on-chain:
//   - the credential content and its digest
//   - the commitment salt
//   - the holder's identity (their public key is bound inside the commitment)
//   - the issuer's and holder's secret keys

// Deploy-time issuer authority. Only the party holding the matching secret key
// can issue or revoke (checked in-circuit, never by signature on-chain).
export ledger issuerPk: Bytes<32>;

// credentialId → persistentCommit([contentDigest, holderPk], salt)
export ledger credentialCommitments: Map<Uint<64>, Bytes<32>>;

// credentialId → credential type (a public taxonomy id, e.g. 1 = SOC2 Type II)
export ledger credentialTypes: Map<Uint<64>, Uint<64>>;

// credentialId → expiry, seconds since the UNIX epoch (compared to block time)
export ledger credentialExpiry: Map<Uint<64>, Uint<64>>;

// credential IDs the issuer has revoked
export ledger revokedCredentials: Set<Uint<64>>;

// credentialId → a holder presented a valid proof (reset on revocation)
export ledger verifiedCredentials: Map<Uint<64>, Boolean>;

export ledger totalCredentialProofs: Counter;

// PRIVATE inputs, supplied by the local witness implementation.
witness issuerSecretKey(): Bytes<32>;
witness holderSecretKey(): Bytes<32>;
// The holder's public key is a witness (issuer-side private state), not a
// circuit argument, so it never appears in any transaction field.
witness holderPublicKey(credentialId: Uint<64>): Bytes<32>;
witness credentialDigest(credentialId: Uint<64>): Bytes<32>;
witness credentialSalt(credentialId: Uint<64>): Bytes<32>;

// Domain-separated key derivation. Exported so clients derive the same
// public keys off-chain via pureCircuits (no on-chain state touched).
export circuit derivePk(sk: Bytes<32>, domain: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([domain, sk]);
}

constructor(issuerPublicKey: Bytes<32>) {
  issuerPk = disclose(issuerPublicKey);
}

// Issuer registers a credential. The holder's public key is bound inside the
// commitment and is NOT published. Type and expiry are public by design: a
// verifier must be able to read the policy the credential is checked against.
export circuit issueCredential(credentialId: Uint<64>, typeId: Uint<64>, expiry: Uint<64>): [] {
  assert(derivePk(issuerSecretKey(), pad(32, "cred:issuer")) == issuerPk, "caller is not the issuer");
  assert(!credentialCommitments.member(disclose(credentialId)), "credential id already issued");
  const commitment = persistentCommit<Vector<2, Bytes<32>>>(
    [credentialDigest(credentialId), holderPublicKey(credentialId)],
    credentialSalt(credentialId)
  );
  credentialCommitments.insert(disclose(credentialId), disclose(commitment));
  credentialTypes.insert(disclose(credentialId), disclose(typeId));
  credentialExpiry.insert(disclose(credentialId), disclose(expiry));
  verifiedCredentials.insert(disclose(credentialId), false);
}

// Issuer revokes a credential. Public and irreversible.
export circuit revokeCredential(credentialId: Uint<64>): [] {
  assert(derivePk(issuerSecretKey(), pad(32, "cred:issuer")) == issuerPk, "caller is not the issuer");
  assert(credentialCommitments.member(disclose(credentialId)), "unknown credential");
  revokedCredentials.insert(disclose(credentialId));
  verifiedCredentials.insert(disclose(credentialId), false);
}

// Holder proves: the credential exists, is not revoked, has not expired at
// the current block time, and the caller is its holder and knows its
// content. Only success or failure escapes the circuit.
export circuit proveCredential(credentialId: Uint<64>): [] {
  assert(credentialCommitments.member(disclose(credentialId)), "unknown credential");
  assert(!revokedCredentials.member(disclose(credentialId)), "credential revoked");
  assert(blockTimeLt(credentialExpiry.lookup(disclose(credentialId))), "credential expired");
  const holderPk = derivePk(holderSecretKey(), pad(32, "cred:holder"));
  const commitment = persistentCommit<Vector<2, Bytes<32>>>(
    [credentialDigest(credentialId), holderPk],
    credentialSalt(credentialId)
  );
  assert(credentialCommitments.lookup(disclose(credentialId)) == commitment, "not the holder of this credential");
  verifiedCredentials.insert(disclose(credentialId), true);
  totalCredentialProofs.increment(1);
}
