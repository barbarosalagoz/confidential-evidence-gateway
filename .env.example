# Copy to .env and edit. .env is git-ignored — never commit real values.

# ─── PUBLIC ────────────────────────────────────────────────────────────────────
# The policy threshold. This is written to the ledger as `publicMinimumScore`
# and is visible to everyone. It is the one value the contract deliberately
# discloses, because a policy nobody can read cannot be audited against.
MINIMUM_SCORE=70

# ─── PRIVATE ───────────────────────────────────────────────────────────────────
# The supplier's actual compliance score. Fed to the prover as a witness and
# stored only in the local encrypted private-state store. It is never part of
# any transaction and never reaches the chain. Treat this file like a secret.
COMPLIANCE_SCORE=85

# Password for the local encrypted private-state store (min 16 characters).
# Required for any non-local network. Generate a strong random value.
# PRIVATE_STATE_PASSWORD=

# Optional: how long `npm run setup` waits for faucet funds (default 600000 ms).
# MIDNIGHT_FAUCET_TIMEOUT_MS=600000
